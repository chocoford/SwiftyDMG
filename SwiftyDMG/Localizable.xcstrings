    "errorInvalidAppMetadata": {
      "comment": "User-facing text: error invalid app metadata.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app’s Info.plist could not be read. Select a valid macOS app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取应用的 Info.plist。请选择一个有效的 macOS 应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取應用程式的 Info.plist。請選擇一個有效的 macOS 應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの Info.plist を読み取ることができませんでした。有効な macOS アプリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 Info.plist를 읽을 수 없습니다. 유효한 macOS 앱을 선택하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Info.plist de l'application n'a pas pu être lu. Sélectionnez une application macOS valide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Info.plist der App konnte nicht gelesen werden. Wählen Sie eine gültige macOS-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el Info.plist de la aplicación. Selecciona una aplicación macOS válida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere l'Info.plist dell'app. Seleziona un'app macOS valida."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Info.plist do aplicativo não pôde ser lido. Selecione um aplicativo macOS válido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Info.plist van de app kon niet worden gelezen. Selecteer een geldige macOS-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać pliku Info.plist aplikacji. Wybierz prawidłową aplikację macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать Info.plist приложения. Выберите действительное приложение для macOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة ملف Info.plist للتطبيق. حدد تطبيق macOS صالح."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप का Info.plist नहीं पढ़ा जा सका। एक मान्य macOS ऐप चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถอ่าน Info.plist ของแอพได้ โปรดเลือกแอพ macOS ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın Info.plist dosyası okunamadı. Geçerli bir macOS uygulaması seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc Info.plist của ứng dụng. Chọn một ứng dụng macOS hợp lệ."
          }
        }
      }
    },
