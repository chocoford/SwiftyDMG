          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida ya existe. Confirma la sustitución o elige otro nombre de archivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output esiste già. Conferma la sostituzione o scegli un altro nome file."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída já existe. Confirme a substituição ou escolha outro nome de arquivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitvoer bestaat al. Bevestig vervanging of kies een andere bestandsnaam."
