    "buildStartHelp": {
      "comment": "User-facing text: build start help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the play button in the toolbar to create a DMG.\nBuild progress and logs will appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击工具栏中的播放按钮以创建 DMG。\n构建进度和日志将在此处显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊工具欄中的播放按鈕以創建 DMG。\n構建進度和日誌將顯示在這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの再生ボタンをクリックしてDMGを作成します。\nビルドの進行状況とログがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바의 재생 버튼을 클릭하여 DMG를 생성하세요.\n빌드 진행 상태 및 로그가 여기 나타납니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton de lecture dans la barre d'outils pour créer un DMG.\nLa progression et les journaux de construction apparaîtront ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf die Wiedergabetaste in der Symbolleiste, um eine DMG zu erstellen.\nDer Build-Fortschritt und Protokolle werden hier angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el botón de reproducir en la barra de herramientas para crear un DMG.\nEl progreso de la construcción y los registros aparecerán aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca il pulsante di riproduzione nella barra degli strumenti per creare un DMG.\nIl progresso della build e i log appariranno qui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão de play na barra de ferramentas para criar um DMG.\nO progresso da construção e os logs aparecerão aqui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de afspeelknop in de werkbalk om een DMG te maken.\nDe voortgang en logs van de build verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij przycisk odtwarzania na pasku narzędzi, aby utworzyć DMG.\nPostęp budowy i dzienniki pojawią się tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку воспроизведения на панели инструментов, чтобы создать DMG.\nПрогресс сборки и журналы будут отображаться здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على زر التشغيل في شريط الأدوات لإنشاء DMG.\nستظهر هنا تقدم البناء والسجلات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG बनाने के लिए टूलबार में प्ले बटन पर क्लिक करें।\nबिल्ड प्रगति और लॉग यहाँ दिखाई देंगे।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่มเล่นในแถบเครื่องมือเพื่อสร้าง DMG\nความก้าวหน้าในการสร้างและบันทึกจะปรากฏที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG oluşturmak için araç çubuğundaki oynat butonuna tıklayın.\nİnşaat ilerlemesi ve günlükler burada görünecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào nút phát trong thanh công cụ để tạo một DMG.\nTiến trình xây dựng và nhật ký sẽ xuất hiện ở đây."
          }
        }
      }
    },
