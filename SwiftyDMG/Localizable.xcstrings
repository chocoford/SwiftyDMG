          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف الناتج موجود بالفعل. يرجى تأكيد الاستبدال أو اختيار اسم ملف آخر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आउटपुट पहले से मौजूद है। प्रतिस्थापन की पुष्टि करें या एक और फ़ाइल नाम चुनें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ผลลัพธ์มีอยู่แล้ว ยืนยันการแทนที่หรือเลือกชื่อไฟล์อื่น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıktı zaten mevcut. Değiştirmeyi onaylayın veya başka bir dosya adı seçin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ra đã tồn tại. Xác nhận thay thế hoặc chọn tên tệp khác."
          }
        }
      }
    },
