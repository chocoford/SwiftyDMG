    "dialogRenameFileHelp": {
      "comment": "User-facing text: dialog rename file help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes the name inside the disk image. The original file is not renamed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会更改磁盘映像内部的名称。原始文件不会被重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會更改磁碟映像內的名稱。原始檔案不會被重命名。"
          }
        },
