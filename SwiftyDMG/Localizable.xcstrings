    "errorInvalidOutputLocation": {
      "comment": "User-facing text: error invalid output location.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The output must be a .dmg file outside the app bundle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输出必须是一个在应用包外的 .dmg 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出必須是位於應用程式包外的 .dmg 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力はアプリバンドルの外にある .dmg ファイルでなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출력은 앱 번들 외부의 .dmg 파일이어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie doit être un fichier .dmg en dehors du bundle de l'application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Output muss eine .dmg-Datei außerhalb des App-Bundles sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida debe ser un archivo .dmg fuera del paquete de la aplicación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output deve essere un file .dmg al di fuori del pacchetto app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída deve ser um arquivo .dmg fora do pacote do aplicativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitvoer moet een .dmg-bestand buiten de app-bundel zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik musi być plikiem .dmg poza pakietem aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выходной файл должен быть .dmg и находиться вне пакета приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون المخرجات ملف .dmg خارج حزمة التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आउटपुट .dmg फ़ाइल ऐप बंडल के बाहर होनी चाहिए।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์จะต้องเป็นไฟล์ .dmg ที่อยู่นอกแอพ bundle"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıktı, uygulama paketinin dışında bir .dmg dosyası olmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ra phải là tệp .dmg bên ngoài gói ứng dụng."
          }
        }
      }
    },
    "errorInvalidVolumeName": {
      "comment": "User-facing text: error invalid volume name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The volume name cannot contain slashes, colons, or control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卷名不能包含斜杠、冒号或控制字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卷名不能包含斜杠、冒號或控制字符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボリューム名にはスラッシュ、コロン、または制御文字を含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨 이름에는 슬래시, 콜론 또는 제어 문자가 포함될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du volume ne peut pas contenir de barres obliques, de deux-points ou de caractères de contrôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Volumenname darf keine Schrägstriche, Doppelpunkte oder Steuerzeichen enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del volumen no puede contener barras, dos puntos ni caracteres de control."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome del volume non può contenere barre, due punti o caratteri di controllo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do volume não pode conter barras, dois-pontos ou caracteres de controle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volume-naam mag geen schuine strepen, dubbele punten of controlekarakters bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa woluminu nie może zawierać ukośników, dwukropek ani znaków sterujących."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя тома не может содержать косые черты, двоеточия или управляющие символы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يحتوي اسم الحجم على شرائح أو نقطتين أو أحرف تحكم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम का नाम स्लैश, कॉलन या नियंत्रण चर नहीं रख सकता।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อ volume ไม่สามารถมีสแลช สองจุด หรืออักขระควบคุมได้."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacim adı, eğik çizgi, iki nokta veya kontrol karakterleri içeremez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên volume không được chứa dấu gạch chéo, dấu hai chấm, hoặc ký tự điều khiển."
          }
        }
      }
    },
    "errorInvalidWindowSize": {
      "comment": "User-facing text: error invalid window size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window width must be 320–4096 and height must be 240–4096."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口宽度必须在 320 到 4096 之间，高度必须在 240 到 4096 之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口寬度必須在320–4096之間，高度必須在240–4096之間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウの幅は320～4096、高さは240～4096でなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 너비는 320–4096, 높이는 240–4096이어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La largeur de la fenêtre doit être comprise entre 320 et 4096 et la hauteur entre 240 et 4096."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fensterbreite muss zwischen 320 und 4096 und die Höhe zwischen 240 und 4096 liegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ancho de la ventana debe estar entre 320 y 4096 y la altura debe estar entre 240 y 4096."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La larghezza della finestra deve essere compresa tra 320 e 4096 e l'altezza deve essere compresa tra 240 e 4096."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A largura da janela deve ser de 320 a 4096 e a altura deve ser de 240 a 4096."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vensterbreedte moet 320–4096 zijn en de hoogte 240–4096."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość okna musi wynosić od 320 do 4096, a wysokość od 240 do 4096."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина окна должна быть от 320 до 4096, а высота — от 240 до 4096."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون عرض النافذة بين 320-4096 وارتفاعها بين 240-4096."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विंडो की चौड़ाई 320–4096 और ऊँचाई 240–4096 होनी चाहिए।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างของหน้าต่างต้องอยู่ที่ 320–4096 และความสูงต้องอยู่ที่ 240–4096."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere genişliği 320–4096 ve yüksekliği 240–4096 olmalıdır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều rộng cửa sổ phải từ 320–4096 và chiều cao từ 240–4096."
          }
        }
      }
    },
