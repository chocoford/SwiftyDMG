    "dialogQuitDuringBuildHelp": {
      "comment": "User-facing text: dialog quit during build help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current build to finish before quitting so temporary disk images can be safely unmounted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在退出之前，请等待当前构建完成，以便可以安全卸载临时磁盘映像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在退出之前，請等待當前的構建完成，以便可以安全卸載臨時磁碟映像。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のビルドが完了するまで待機して、仮想ディスクイメージを安全にアンマウントできるようにしてから終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 빌드가 완료될 때까지 기다리면 임시 디스크 이미지가 안전하게 분리될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez que la construction actuelle soit terminée avant de quitter afin que les images disque temporaires puissent être démontées en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis der aktuelle Build abgeschlossen ist, bevor Sie beenden, damit temporäre Disk-Images sicher demontiert werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que se complete la construcción actual antes de salir para que las imágenes de disco temporales se puedan desmontar de manera segura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere che la compilazione corrente sia completata prima di uscire in modo che le immagini disco temporanee possano essere smontate in modo sicuro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da construção atual antes de sair para que as imagens de disco temporárias possam ser desmontadas com segurança."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de huidige build is voltooid voordat u afsluit, zodat tijdelijke schijfimages veilig kunnen worden ontkoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie bieżącej kompilacji przed zamknięciem, aby tymczasowe obrazy dysków mogły zostać bezpiecznie odmontowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подождите, пока текущая сборка не завершится, прежде чем выходить, чтобы временные образы дисков могли быть безопасно отключены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى تنتهى عملية البناء الحالية قبل الإغلاق حتى يمكن فصل صور الأقراص المؤقتة بأمان."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया quitting करने से पहले वर्तमान निर्माण के खत्म होने का इंतजार करें ताकि अस्थायी डिस्क इमेज को सुरक्षित रूप से अनमाउंट किया जा सके।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณารอให้การสร้างปัจจุบันเสร็จสิ้นก่อนที่จะออกจากโปรแกรมเพื่อให้สามารถยกเลิกการใช้งานดิสก์ภาพชั่วคราวได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli derlemenin tamamlanmasını bekleyin, böylece geçici disk görüntüleri güvenli bir şekilde sökülebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đợi quá trình xây dựng hiện tại hoàn thành trước khi thoát để các hình ảnh đĩa tạm thời có thể được tháo gỡ một cách an toàn."
          }
        }
      }
    },
