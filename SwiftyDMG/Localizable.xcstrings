    "errorOutputAlreadyExists": {
      "comment": "User-facing text: error output already exists.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The output already exists. Confirm replacement or choose another file name."
          }
        },
        "zh-Hans": {
