    "previewAppearanceHelp": {
      "comment": "User-facing text: preview appearance help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the preview appearance. Background images retain their original colors."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择预览外观。背景图像保留其原始颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇預覽外觀。背景圖像保留原始顏色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観を選択してください。背景画像は元の色を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 외관을 선택하세요. 배경 이미지는 원래 색상을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'apparence de l'aperçu. Les images d'arrière-plan conservent leurs couleurs d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das Vorschau-Äußere. Hintergrundbilder behalten ihre ursprünglichen Farben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la apariencia de la vista previa. Las imágenes de fondo conservan sus colores originales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli l'aspetto dell'anteprima. Le immagini di sfondo mantengono i loro colori originali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a aparência de visualização. As imagens de fundo mantêm suas cores originais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de voorbeeldweergave. Achtergrondafbeeldingen behouden hun oorspronkelijke kleuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wygląd podglądu. Obrazy tła zachowują swoje oryginalne kolory."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите внешний вид для предварительного просмотра. Фоновые изображения сохраняют свои оригинальные цвета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مظهر المعاينة. تحتفظ الصور الخلفية بألوانها الأصلية."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्वावलोकन रूपरेखा चुनें। पृष्ठभूमि चित्र अपनी मूल रंगों को बरकरार रखते हैं।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกดูตัวอย่างรูปลักษณ์ รูปภาพพื้นหลังจะรักษาสีเดิมไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme görünümünü seçin. Arka plan resimleri orijinal renklerini korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giao diện xem trước. Hình nền giữ nguyên màu sắc ban đầu của chúng."
          }
        }
      }
    },
