    "inspectorVolumeNameHelp": {
      "comment": "User-facing text: inspector volume name help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name shown when the disk image is mounted. Leave blank to use the app name."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挂载磁盘映像时显示的名称。留空以使用应用名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛載磁碟映像時顯示的名稱。留空以使用應用程式名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクイメージがマウントされたときに表示される名前。アプリ名を使用するには空白のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크 이미지가 마운트될 때 표시되는 이름입니다. 앱 이름을 사용하려면 비워 두십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom affiché lorsque l'image disque est montée. Laissez vide pour utiliser le nom de l'application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name, der angezeigt wird, wenn das Disk-Image eingehängt ist. Lassen Sie es leer, um den App-Namen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre mostrado cuando la imagen de disco está montada. Deja en blanco para usar el nombre de la aplicación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome visualizzato quando l'immagine del disco è montata. Lascia vuoto per usare il nome dell'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome mostrado quando a imagem do disco está montada. Deixe em branco para usar o nome do aplicativo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De naam die wordt weergegeven wanneer de schijfimage is gemonteerd. Laat leeg om de app-naam te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa wyświetlana, gdy obraz dysku jest zamontowany. Pozostaw puste, aby użyć nazwy aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя, отображаемое при монтировании образа диска. Оставьте пустым, чтобы использовать имя приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم المعروض عند تثبيت صورة القرص. اتركه فارغًا لاستخدام اسم التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब डिस्क छवि को माउंट किया जाता है तो दिखाया गया नाम। ऐप नाम का उपयोग करने के लिए छोड़ दें।"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อที่แสดงเมื่ออิมเมจดิสก์ถูกติดตั้ง ว่างเพื่อใช้ชื่อแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk imajı bağlandığında görünen ad. Uygulama adını kullanmak için boş bırakın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên hiển thị khi hình ảnh đĩa được gắn. Để trống để sử dụng tên ứng dụng."
          }
        }
      }
    },
